Rules-Requires-Root: no

Package: libmidas-dev
Section: libdevel
Architecture: any
Multi-Arch: same
Depends:
 libmidas-1.1-2 (= ${binary:Version}),
 ${misc:Depends},
Description: MIDAS Digital Audio System for SDL - development files
 MIDAS Digital Audio System is a multichannel digital sound and music
 system, designed mainly for use in games, demos, and other realtime
 multimedia applications. This is a quick port of MIDAS to SDL 1.2.
 .
 MIDAS is free for non-commercial usage only.
 .
 This package contains the header file and the static library.

Package: libmidas-1.1-2
Architecture: any
Multi-Arch: same
Depends:
 ${misc:Depends},
 ${shlibs:Depends},
Description: MIDAS Digital Audio System for SDL - shared library
 MIDAS Digital Audio System is a multichannel digital sound and music
 system, designed mainly for use in games, demos, and other realtime
 multimedia applications. This is a quick port of MIDAS to SDL 1.2.
 .
 MIDAS is free for non-commercial usage only.
 .
 This package contains the shared library.
