#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# The upstream tree lacks NEWS, AUTHORS and ChangeLog.
override_dh_autoreconf:
	AUTOMAKE="automake --foreign" dh_autoreconf

override_dh_auto_configure:
	dh_auto_configure -- --disable-nasm

# The libtool archive is not shipped.
execute_after_dh_auto_install:
	rm -f debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/libmidas.la
