Description: fix distortion on some soundcards
 On a Starship/Matisse HD Audio Controller, sound was only heard when the
 card was set up as 5.1, so the PulseAudio stream now uses an explicit
 stereo channel map. There was still distortion, because the rate was set
 to 44100 Hz instead of 48000 Hz, which is now the minimum.
 .
 pa_channel_map_init_stereo() comes from libpulse, not libpulse-simple:
 link it explicitly so the library is not underlinked.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: no
Last-Update: 2026-11-12
--- a/src/device_pulse.cpp
+++ b/src/device_pulse.cpp
@@ -19,12 +19,13 @@
 
 
   PulseAudioDevice::PulseAudioDevice(std::string& description)
-    : MixerDevice(44100)
+    : MixerDevice(48000)
   {
   
 	m_ss.format = PA_SAMPLE_S16LE;
-	m_ss.rate = 44100;
+	m_ss.rate = 48000;
 	m_ss.channels = 2;
+	pa_channel_map map;
 	
 	m_sp = pa_simple_new(
 		NULL,					// default server
@@ -33,7 +34,7 @@
 		NULL,					// default device
 		description.c_str(),	// description of the stream
 		&m_ss,					// sample format
-		NULL,					// default channel map
+		pa_channel_map_init_stereo(&map),					// we init stereo mapping
 		NULL,					// default buffering attributes,
 		NULL					// ignore error code
 	);
--- a/configure.ac
+++ b/configure.ac
@@ -219,8 +219,8 @@
 AC_CHECK_HEADER(pulse/simple.h,
     HAVE_PULSE=true
     AC_DEFINE(HAVE_PULSE)
-    LIBS="-lpulse-simple $LIBS"
-    EXTRA_LIBS="-lpulse-simple $EXTRA_LIBS"
+    LIBS="-lpulse-simple -lpulse $LIBS"
+    EXTRA_LIBS="-lpulse-simple -lpulse $EXTRA_LIBS"
   ,
     AC_MSG_WARN([Could not find pulse header.  You do not appear to have libpulse installed.])
     AC_MSG_WARN([Disabling Pulse Audio support.])
