#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

# upstream names the 64-bit library libfmodex64-<version>.so
export EXT := $(if $(filter amd64,$(DEB_HOST_ARCH)),64)

%:
	dh $@

# prebuilt upstream library, already stripped, no debug info
override_dh_strip:

override_dh_auto_configure:
	sed 's/@DEB_HOST_MULTIARCH@/$(DEB_HOST_MULTIARCH)/g' debian/fmodex.pc.in > debian/fmodex.pc
