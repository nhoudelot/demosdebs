--- a/unpack.header2
+++ b/unpack.header2
@@ -1 +1,4 @@
-tail -n+2 $0|zcat>x.c;cc -O3 -lSDL -lGLU x.c -o y;./y>/dev/dsp
+#!/bin/sh
+d=$(mktemp -d)||exit;trap 'rm -rf "$d"' 0;trap '${p:+kill -9 -$p};exit' 1 2 15
+tail -n+5 "$0"|zcat>"$d/x.c"&&cd "$d"&&mkfifo f&&cc -std=gnu89 -w x.c -lGL -lGLU -lSDL -lm -o y||exit
+setsid ./y>f&p=$!;aplay -q -t raw -f U8 -r 8000 -c1 <f;wait;exit
