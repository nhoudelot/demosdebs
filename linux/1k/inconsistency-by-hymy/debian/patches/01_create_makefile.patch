Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-13
--- /dev/null
+++ b/src/Makefile
@@ -0,0 +1,31 @@
+#variables de compilation
+SHELL := /bin/sh
+TARGET   := inconsistency-by-hymy
+#variable de nettoyage
+RM_F := rm -f
+#variables d’installation
+INSTALL := install
+INSTALL_DIR     := $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM := $(INSTALL) -p    -m  755
+prefix          := /usr
+exec_prefix     := $(prefix)
+bindir          := $(prefix)/bin
+
+
+all: $(TARGET)
+
+$(TARGET): inconsistency.asm stub
+	nasm inconsistency.asm
+	gzip inconsistency -f -9 -n
+	cat stub inconsistency.gz > $(TARGET)
+	chmod +x $(TARGET)
+	ls -l $(TARGET)
+
+clean:
+	-@$(RM_F) $(TARGET) inconsistency.gz
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
+
--- a/src/stub
+++ b/src/stub
@@ -1 +1,4 @@
-a=/tmp/L;tail -n+2	$0|zcat>$a;chmod +x $a;$a;rm $a;exit
+#!/bin/sh
+d=$(mktemp -d)||exit;trap 'rm -rf "$d"' 0;trap 'exit 1' 1 2 15
+tail -n+5 "$0"|zcat>"$d/i"&&chmod +x "$d/i"||exit
+"$d/i";exit 0
