Description: Look for translations in the top-level translations directory
 The .ts catalogs moved to translations/ but src/CMakeLists.txt still lists
 them under src/gui/translation. The deploy helper then runs lupdate at
 configure time and generates empty catalogs in the source tree, so the
 shipped .qm files contain no translation.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: no
Last-Update: 2026-11-08
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -70,7 +70,7 @@
 if(EXISTS "${DIE_TRANSLATION_HELPER}")
     include("${DIE_TRANSLATION_HELPER}")
 
-    set(DIE_TRANSLATION_DIR "${CMAKE_CURRENT_LIST_DIR}/gui/translation")
+    set(DIE_TRANSLATION_DIR "${CMAKE_CURRENT_LIST_DIR}/../translations")
     set(DIE_TS_FILES
         "${DIE_TRANSLATION_DIR}/die_ar.ts"
         "${DIE_TRANSLATION_DIR}/die_bn.ts"
