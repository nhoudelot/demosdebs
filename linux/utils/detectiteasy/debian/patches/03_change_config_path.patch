Description: change data path
 Relocate non-binary architecture-specific files to /usr/share to ensure correct installation
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Applied-Upstream: no
Last-Update: 2024-03-10
---
This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
--- a/XOptions/xoptions.cpp
+++ b/XOptions/xoptions.cpp
@@ -386,7 +386,7 @@
     if (bIsNative) {
         pSettings = new QSettings;
     } else {
-        pSettings = new QSettings(qApp->applicationDirPath() + QDir::separator() + QString("%1").arg(m_sName), QSettings::IniFormat);
+        pSettings = new QSettings(getConfigPath() + QDir::separator() + QString("%1").arg(m_sName), QSettings::IniFormat);
     }
 
 #ifdef QT_DEBUG
@@ -784,6 +784,14 @@
     return sResult;
 }
 
+QString XOptions::getConfigPath()
+{
+    QString sResult;
+    sResult=QStandardPaths::writableLocation(QStandardPaths::AppConfigLocation);
+
+    return sResult;
+}
