Description: Use Debian build flags exported by dh in all Makefiles
 Append to CFLAGS/LDFLAGS/CPPFLAGS instead of overwriting them, so the
 hardening flags exported by dh_auto_build are used. The flags are no
 longer computed with $(shell dpkg-buildflags) inside the subdirectories:
 there, debian/changelog cannot be found, so the ELF package metadata was
 missing and the flags were added twice.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-08
--- a/libhxcfe/build/Makefile
+++ b/libhxcfe/build/Makefile
@@ -15,12 +15,12 @@
 EM_PTHREAD ?= 1
 
 ifeq ($(DEBUG), 1)
-	CFLAGS = -O0 $(INCLUDES) -Wall -DDEBUG
-	LDFLAGS = -shared
+	CFLAGS += -O0 $(INCLUDES) -Wall -DDEBUG
+	LDFLAGS += -shared
 	DEBUG_INFOS = 1
 else
-	CFLAGS = -O3 $(INCLUDES) -Wall
-	LDFLAGS = -shared
+	CFLAGS += -O3 $(INCLUDES) -Wall
+	LDFLAGS += -shared
 endif
 
 ifeq ($(DEBUG_ASAN), 1)
