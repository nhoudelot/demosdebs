Description: fix SDL2 audio callback
 Output float samples to match the AUDIO_F32SYS format requested in
 05_migrate_to_SDL2.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-04-03
--- a/intro_c.c
+++ b/intro_c.c
@@ -614,13 +614,12 @@
 static int audio_cursor = 0;
 
 static void audioPlay(void *userdata, Uint8 *stream, int len) {
-	short *p = (short*)stream;
-	int i;
-	len /= sizeof(short);
-	for (i = 0; i < len; ++i) {
-		audio_cursor = (audio_cursor + 1) % (MAX_SAMPLES * 2);
-		p[i] = sound_buffer[audio_cursor] * 32767.f;
-	}
+    float *p = (float*)stream;
+    len /= sizeof(float);
+    for (int i = 0; i < len; ++i) {
+        audio_cursor = (audio_cursor + 1) % (MAX_SAMPLES * 2);
+        p[i] = sound_buffer[audio_cursor];
+    }
 }
 
