 	sdlGlcontext = SDL_GL_CreateContext(sdlWindow);
+	/* V-Sync, must be set after the context creation */
+	SDL_GL_SetSwapInterval(1);
 
-    /* Taille réelle du drawable, HiDPI inclus */
-    int drawW, drawH;
-    SDL_GL_GetDrawableSize(sdlWindow, &drawW, &drawH);
-
-    /* Viewport centré, ratio XRES/YRES préservé */
-    int vpW, vpH, vpX, vpY;
-    if (drawW * YRES > drawH * XRES) {
-        vpH = drawH;
-        vpW = drawH * XRES / YRES;
-    } else {
-        vpW = drawW;
-        vpH = drawW * YRES / XRES;
-    }
-    vpX = (drawW - vpW) / 2;
-    vpY = (drawH - vpH) / 2;
-
-    //glViewport(vpX, vpY, vpW, vpH);
-    SetViewport(sdlWindow);
+	/* centered viewport keeping the XRES/YRES aspect ratio (HiDPI aware) */
+	SetViewport(sdlWindow);
     introInit();
 
 #ifndef CAPTURE
@@ -523,20 +509,21 @@
 	for (;;) {
 		const uint32_t now = ((frame++) * 1000.f) / CAPTURE_FRAMERATE;
 #endif
+		if (now >= INTRO_LENGTH) break;
 		SDL_Event e;
-		SDL_PollEvent(&e);
-		if ((e.type == SDL_KEYDOWN && e.key.keysym.sym == SDLK_ESCAPE) || now >= INTRO_LENGTH) break;
-		if ((e.type == SDL_QUIT) || now >= INTRO_LENGTH) break;
-		if (e.type == SDL_WINDOWEVENT &&
-            (e.window.event == SDL_WINDOWEVENT_RESIZED ||
-             e.window.event == SDL_WINDOWEVENT_SIZE_CHANGED)) {
-            SetViewport(sdlWindow);
-        }
-		if (e.type == SDL_KEYUP) {
-		    switch (e.key.keysym.sym) {
-		        case SDLK_f: ToggleFullscreen(sdlWindow); break;
-		    }
+		int quit = 0;
+		while (SDL_PollEvent(&e)) {
+			if (e.type == SDL_QUIT
+				|| (e.type == SDL_KEYDOWN && e.key.keysym.sym == SDLK_ESCAPE))
+				quit = 1;
+			else if (e.type == SDL_KEYUP && e.key.keysym.sym == SDLK_f)
+				ToggleFullscreen(sdlWindow);
+			else if (e.type == SDL_WINDOWEVENT
+				&& (e.window.event == SDL_WINDOWEVENT_RESIZED
+				|| e.window.event == SDL_WINDOWEVENT_SIZE_CHANGED))
+				SetViewport(sdlWindow);
 		}
+		if (quit) break;
 		introPaint((now - start) / 1000.f);
 
