Description: create a makefile for the packaging tools
 The upstream Makefile calls sdl-config and gcc directly. Replace it with
 a makefile that uses pkg-config, honours the build flags given by
 dpkg-buildflags (CPPFLAGS, CFLAGS, LDFLAGS) and the CC of a cross build,
 and installs the program under the package name.
 The intro only draws into an SDL software surface: it is linked with SDL
 and libm only (the former link with GLU was useless).
 Also add the s.h header included by the source (SDL, math, stdlib).
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-13
--- a/Makefile
+++ b/Makefile
@@ -1,6 +1,34 @@
-CFLAGS = `sdl-config --cflags`
-LDLIBS = `sdl-config --libs`
+#variables de compilation
+SHELL = /bin/sh
+CC    ?= gcc
+PKG_CONFIG ?=pkg-config
+CFLAGS   +=  -std=c99 -Wall -pipe -fstrict-aliasing $(shell $(PKG_CONFIG) --cflags sdl)
+LDLIBS   += $(shell $(PKG_CONFIG) --libs sdl) -lm
+TARGET   = analeptique-by-acetate
+#variables d'instalation
+INSTALL = install
+INSTALL_DIR     = $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM = $(INSTALL) -p    -m  755
+prefix          = /usr
+exec_prefix     = $(prefix)
+bindir          = $(prefix)/bin
+#variable de nettoyage
+RM_F := rm -f
 
-all:
-	gcc $(CFLAGS) $(LDLIBS) analeptique.c -o analeptique -ansi -O2
-	@echo Analeptique \~ source size \(bytes\) : && cat analeptique.c | perl -pe 's/[\s\r\n]//g' | wc -c
\ No newline at end of file
+
+SOURCE          = analeptique.c
+
+export
+
+all: $(TARGET)
+
+$(TARGET): $(SOURCE)
+	 $(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $(TARGET) $(SOURCE) $(LDLIBS)
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
+
+clean:
+	-$(RM_F) $(TARGET)
