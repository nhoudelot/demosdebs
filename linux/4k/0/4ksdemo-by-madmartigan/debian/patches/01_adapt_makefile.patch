Description: create makefile & g.h
 Create a makefile so that the intro builds with the packaging tools,
 using pkg-config and the build flags given by dpkg-buildflags
 (CPPFLAGS, CXXFLAGS, LDFLAGS).
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-13
--- /dev/null
+++ b/g.h
@@ -0,0 +1,5 @@
+#include "SDL.h"
+#include "SDL_opengl.h"
+#include <math.h>
+#include <stdlib.h>
+
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,31 @@
+#variables de compilation
+SHELL = /bin/sh
+CXX   ?= g++
+PKG_CONFIG ?= pkg-config
+CXXFLAGS += -Wall -pipe -ansi -pedantic -std=gnu++98 -fabi-version=2 $(shell $(PKG_CONFIG) --cflags sdl glu)
+LDFLAGS  += $(shell $(PKG_CONFIG) --libs sdl glu gl) -lm
+TARGET   := 4ksdemo-by-madmartigan
+#variable de nettoyage
+RM_F := rm -f
+#variables d'instalation
+INSTALL := install
+INSTALL_DIR     := $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM := $(INSTALL) -p    -m  755
+prefix          := /usr
+exec_prefix     := $(prefix)
+bindir          := $(prefix)/bin
+
+SOURCE          = main.cpp
+
+all: $(TARGET)
+
+$(TARGET): $(SOURCE)
+	 $(CXX) $(SOURCE) $(CPPFLAGS) $(CXXFLAGS) -o $(TARGET) $(LDFLAGS)
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
+
+clean:
+	-$(RM_F) $(TARGET)
