+/* Debian: the animation advances by a fixed step per frame, so cap
+   the frame rate to keep the original speed on modern hardware */
+#ifndef DEMO_FPS
+#define DEMO_FPS 60
+#endif
+static void limit_fps (void)
+{
+  static Uint32 fps_t0 = 0, fps_n = 0;
+  Uint32 now = SDL_GetTicks (), due;
+
+  if (!fps_t0) fps_t0 = now;
+  due = fps_t0 + (++fps_n) * 1000 / DEMO_FPS;
+  if (due > now) SDL_Delay (due - now);
+  else if (now - due > 250) { fps_t0 = now; fps_n = 0; }
+}
