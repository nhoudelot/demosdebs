Description: adapt the Makefile to packaging
 Honour the CPPFLAGS (fortify), CFLAGS and LDFLAGS set by dpkg-buildflags,
 add an install target and name the binary after the package. Link
 against ncurses only: libtermcap is an alias of libtinfo, which the
 ncurses linker script already pulls in.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-13
--- a/Makefile
+++ b/Makefile
@@ -1,2 +1,29 @@
-demo: demo.c
-	cc -g demo.c -o demo -lcurses -ltermcap -lm
\ No newline at end of file
+#variables de compilation
+SHELL = /bin/sh
+CC    ?= gcc
+CFLAGS   +=-Wall -std=gnu90 -pipe
+LDLIBS   = -lncurses -lm
+TARGET=cursesdemo-by-dc5
+RM_F := rm -f
+
+INSTALL = install
+INSTALL_DIR     = $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM = $(INSTALL) -p    -m  755
+prefix = /usr
+exec_prefix = $(prefix)
+bindir = $(exec_prefix)/bin
+
+SOURCE          = demo.c
+
+all: $(TARGET)
+
+$(TARGET): $(SOURCE)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) $(SOURCE) -o $(TARGET) $(LDLIBS)
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
+
+clean:
+	-@$(RM_F) $(TARGET)
