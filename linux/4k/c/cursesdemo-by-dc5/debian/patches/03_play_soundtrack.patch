--- a/demo.c
+++ b/demo.c
@@ -7,6 +7,42 @@
 #include <sys/ioctl.h>
 #include <string.h>
 #include <assert.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <unistd.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+
+#ifndef SOUNDTRACK
+#define SOUNDTRACK "/usr/share/cursesdemo-by-dc5/patchbay.mp3"
+#endif
+
+/* play the soundtrack with mpg123 in the background; the demo stays
+ * silent if mpg123 is not installed or cannot open the audio device */
+static pid_t startmusic(void) {
+	pid_t pid;
+	int devnull;
+
+	if(access(SOUNDTRACK, R_OK) != 0) return -1;
+	pid = fork();
+	if(pid == 0) {
+		devnull = open("/dev/null", O_RDWR);
+		if(devnull >= 0) {
+			dup2(devnull, 0);
+			dup2(devnull, 1);
+			dup2(devnull, 2);
+		}
+		execlp("mpg123", "mpg123", "-q", SOUNDTRACK, (char *)NULL);
+		_exit(127);
+	}
+	return pid;
+}
+
+static void stopmusic(pid_t pid) {
+	if(pid <= 0) return;
+	kill(pid, SIGTERM);
+	waitpid(pid, NULL, 0);
+}
 
