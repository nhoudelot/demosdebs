#!/usr/bin/make -f

%:
	dh $@

override_dh_strip:
	dh_strip -Xccsq_fixed_audio

# The executable has no section header table: dpkg-shlibdeps cannot read
# it. Compute the shlibs on a stub with the same libc and libm imports
# instead (see debian/shlibs-stub.c). libSDL-1.2.so.0 and libGL.so.1 are
# declared by hand in debian/control.
override_dh_shlibdeps:
	$(CC) -o debian/shlibs-stub debian/shlibs-stub.c -lm
	dpkg-shlibdeps -Tdebian/cherrycherrysquarewave-by-funnycurlycatcodefactory.substvars -edebian/shlibs-stub
	rm -f debian/shlibs-stub
