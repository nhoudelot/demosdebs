Description: adapt the Makefile to packaging
 Use pkg-config (cross-build friendly) instead of sdl-config, honour the
 CPPFLAGS, CFLAGS and LDFLAGS set by dpkg-buildflags, add an install target
 and name the binary after the package. GLU is not linked any more: the
 intro only calls core OpenGL functions. g.h gathers the includes.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-13
--- a/Makefile
+++ b/Makefile
@@ -1,6 +1,32 @@
-CC=gcc
-CFLAGS=`sdl-config --cflags` -g -W -Wall -std=c99 -pedantic
-LDFLAGS=`sdl-config --libs` -lGL -lm
+#variables de compilation
+SHELL = /bin/sh
+CC    ?= gcc
+PKG_CONFIG ?= pkg-config
+CFLAGS   += -std=c99 -Wall -pipe $(shell $(PKG_CONFIG) --cflags sdl gl)
+LDFLAGS  += $(shell $(PKG_CONFIG) --libs sdl gl) -lm
+TARGET   := canyonflight-by-cypou
+#variable de nettoyage
+RM_F := rm -f
+#variables d'instalation
+INSTALL = install
+INSTALL_DIR     = $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM = $(INSTALL) -p    -m  755
+prefix          = /usr
+exec_prefix     = $(prefix)
+bindir          = $(prefix)/bin
 
-all: canyonflight
+SOURCE          = canyonflight.c
 
+
+all: $(TARGET)
+
+$(TARGET): $(SOURCE)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SOURCE) -o $(TARGET) $(LDFLAGS)
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
+
+clean:
+	-$(RM_F) $(TARGET)
--- /dev/null
+++ b/g.h
@@ -0,0 +1,5 @@
+#include "SDL.h"
+#include "SDL_opengl.h"
+#include <math.h>
+#include <stdlib.h>
