-#define DEMO_XASPECT 4.0f
-#define DEMO_YASPECT 3.0f
+// Aspect ratio of the drawable, updated when the window is resized
+static float aspectRatio = S_WIDTH/(float)S_HEIGHT;
 
 // Direction
 static int curSeed = 0;
@@ -552,7 +552,7 @@
 
 	uniforms[6] = timeOffset / 1000.f;
 	uniforms[7] = ( timeOffset - transitionStart ) / 3310.f;
-	uniforms[10] = S_WIDTH/(float)S_HEIGHT;
+	uniforms[10] = aspectRatio;
 
