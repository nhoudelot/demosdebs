--- a/s.h
+++ b/s.h
@@ -1,4 +1,25 @@
+#define _POSIX_C_SOURCE 200112L
 #include <SDL/SDL.h>
 #include <math.h>
 #include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+
+/* Debian: read all pending events, quit on window close or Escape,
+   return 1 when another key skips the current part */
+static int ev(void)
+{
+	SDL_Event e;
+	int k = 0;
+	while (SDL_PollEvent(&e)) {
+		if (e.type == SDL_QUIT ||
+		    (e.type == SDL_KEYDOWN && e.key.keysym.sym == SDLK_ESCAPE)) {
+			SDL_Quit();
+			exit(0);
+		}
+		if (e.type == SDL_KEYDOWN)
+			k = 1;
+	}
+	return k;
+}
 
