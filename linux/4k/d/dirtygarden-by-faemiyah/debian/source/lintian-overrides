# The upstream archive ships the original prebuilt release executables in
# rel/. They are kept as shipped upstream, the package is built from
# src/ and these files are not installed.
source-is-missing [rel/dirty_garden_freebsd-amd64]
source-is-missing [rel/dirty_garden_freebsd-ia32]
source-is-missing [rel/dirty_garden_linux-amd64]
source-is-missing [rel/dirty_garden_linux-ia32]

# Windows release of the intro and its runtime DLLs, kept as shipped
# upstream in rel/, not used to build the package and not installed.
source-contains-prebuilt-windows-binary [rel/SDL.dll]
source-contains-prebuilt-windows-binary [rel/dirty_garden_windows-ia32.exe]
source-contains-prebuilt-windows-binary [rel/glew32.dll]
