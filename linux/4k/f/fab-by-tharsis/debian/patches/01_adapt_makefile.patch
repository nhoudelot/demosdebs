Description: create a makefile for the packaging tools
 The upstream Makefile calls sdl-config and builds a debugging binary.
 Replace it with a makefile that uses pkg-config, honours the build flags
 given by dpkg-buildflags (CPPFLAGS, CFLAGS, LDFLAGS) and the CC of a
 cross build, and installs the program under the package name.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-14
--- a/Makefile
+++ b/Makefile
@@ -1,11 +1,31 @@
-SRCS = main.c
+#variables de compilation
+SHELL = /bin/sh
+CC   ?= gcc
+PKG_CONFIG ?= pkg-config
+CFLAGS   += -std=c99 -Wall -pipe $(shell $(PKG_CONFIG) --cflags sdl glu gl)
+LDLIBS   += $(shell $(PKG_CONFIG) --libs sdl glu gl) -lm
+TARGET   := fab-by-tharsis
+#variable de nettoyage
+RM_F := rm -f
+#variables d'instalation
+INSTALL = install
+INSTALL_DIR     = $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM = $(INSTALL) -p    -m  755
+prefix          = /usr
+exec_prefix     = $(prefix)
+bindir          = $(prefix)/bin
 
-CFLAGS=$(shell sdl-config --cflags) -g -O3
-LDFLAGS=$(shell sdl-config --libs) -lGLU -lGL -g -O3
+SOURCE          = main.c
 
-main: $(SRCS:.c=.o)
-	$(CC) -o $@ $< $(LDFLAGS)
-	cat $(SRCS) | tr -d " \n\t" | wc -c
+all: $(TARGET)
 
-syn: syn.o
-	$(CC) -o $@ $< $(LDFLAGS)
+$(TARGET): $(SOURCE)
+	 $(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $(TARGET) $(SOURCE) $(LDLIBS)
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
+
+clean:
+	-$(RM_F) $(TARGET)
