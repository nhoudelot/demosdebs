@@ -2329,6 +2331,36 @@
 ; Bss ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 
+%ifdef AUTOMAKE
+; Debian: entry point added in its own sections, so that the original code
+; and data keep their layout (the synth reads code bytes as noise, and the
+; loop counters are addressed relative to the song data).
+SECTION .text.startup progbits alloc exec nowrite align=16
+main:
+; default to the X11 video driver, without overriding SDL_VIDEODRIVER
+	push	dword 0
+	push	dword str_x11
+	push	dword str_videodriver
+	call	setenv
+	add	esp, 12
+; SDL_Init early (the second call in pinp_main does nothing more), then
+; enable V-Sync, which must be set before SDL_SetVideoMode
+	push	dword SDL_INIT_VIDEO + SDL_INIT_AUDIO
+	call	SDL_Init
+	add	esp, 4
+	push	dword 1
+	push	dword SDL_GL_SWAP_CONTROL
+	call	SDL_GL_SetAttribute
+	add	esp, 8
+	jmp	pinp_main
+
+SECTION .rodata
+str_videodriver:
+	db 'SDL_VIDEODRIVER', 0
+str_x11:
+	db 'x11', 0
+%endif
+
 SECTION .bss
 
 var_kayra		resd	500
