Description: make binary installable with autotools
 Install the intro as /usr/bin/pinp-by-faemiyah. The ftoi helper (a
 float to hex converter used during development) is still built but is
 no longer installed.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-17
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -3,7 +3,8 @@
 	nasm -f elf -D AUTOMAKE -o $@ $<
 
 ftoi_SOURCES = ftoi.cpp
-pinp_SOURCES = pinp.nsm \
+pinp_by_faemiyah_SOURCES = pinp.nsm \
 	       dummy.c
 
-noinst_PROGRAMS = ftoi pinp
+noinst_PROGRAMS = ftoi
+bin_PROGRAMS = pinp-by-faemiyah
