-float	A[N], l = 9e-3, R = 1e-1, D = 4e-2;
+float	A[2 * N + 1], l = 9e-3, R = 1e-1, D = 4e-2;
 float	pi2 = 6.283185, pia = 1.570793 / N;
 
 void	init()
