Description: adapt the Makefile to Debian packaging
 Use pkg-config for SDL, honour CPPFLAGS, CFLAGS and LDFLAGS from
 dpkg-buildflags (hardening), rename the program and add an install target.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-20
--- a/Makefile
+++ b/Makefile
@@ -1,22 +1,33 @@
-CC = gcc
-CFLAGS = -Wall `sdl-config --cflags` -ggdb
-LIBS = -lm `sdl-config --libs`
-NAME = wave4k
-SRC = wave4k.c
-OBJ = $(SRC:.c=.o)
-RM = rm -f
+#variables de compilation
+SHELL := /bin/sh
+CC    := gcc
+PKG_CONFIG:=pkg-config
+CFLAGS   += -Wall -pipe -std=gnu90 $(shell $(PKG_CONFIG) --cflags sdl)
+LDFLAGS  += $(shell $(PKG_CONFIG) --libs sdl) -lm
+TARGET   := wavetraveler-by-francoischazal
+#variable de nettoyage
+RM_F = rm -f
+#variables d'instalation
+INSTALL = install
+INSTALL_DIR     = $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM = $(INSTALL) -p    -m  755
+prefix          = /usr
+exec_prefix     = $(prefix)
+bindir          = $(prefix)/bin
 
-all: $(NAME)
+SOURCE          = wave4k.c
 
-$(NAME): $(OBJ)
-	@$(CC) $(CFLAGS) $(OBJ) -o $(NAME) $(LIBS)
+export
 
-.c.o:
-	@$(CC) -c $(CFLAGS) $<
+all: $(TARGET)
 
-clean:
-	@$(RM) *~ \#* *\#
-	@$(RM) *.o
+$(TARGET): $(SOURCE)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SOURCE) -o $(TARGET) $(LDFLAGS)
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
 
-distclean: clean
-	@$(RM) $(NAME)
+clean:
+	-$(RM_F) $(TARGET)
