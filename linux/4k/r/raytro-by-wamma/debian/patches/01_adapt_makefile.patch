Description: adapt the makefile to packaging
 Replace the hand-linked 4k build (ld, sstrip, gzip dropper) by a normal
 build with $(CC), and honour CC, PKG_CONFIG, CPPFLAGS, CFLAGS and LDFLAGS
 from the environment (hardening, cross-building). Add an install target.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-17
--- a/Makefile
+++ b/Makefile
@@ -1,12 +1,31 @@
-all: main
-main:
-	gcc -Os -ffast-math -fshort-double -fpeephole2 -fomit-frame-pointer -c main.c
-	ld -dynamic-linker /lib/ld-linux.so.2 main.o /usr/lib/libSDL.so -o main
-	strip -s -R .comment -R .gnu.version main
-	~/documents/bin/sstrip main
-	7z a -tGZip -mx=9 main.gz main
-	cat unpack.header main.gz > main
-	chmod a+x main
-	rm main.gz main.o
-	wc -c main
+#variables de compilation
+SHELL := /bin/sh
+CC    ?= gcc
+TARGET   := raytro-by-wamma
+PKG_CONFIG ?= pkg-config
+#variable de nettoyage
+RM_F := rm -f
+#variables d'instalation
+INSTALL := install
+INSTALL_DIR     := $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM := $(INSTALL) -p    -m  755
 
+prefix          := /usr
+exec_prefix     := $(prefix)
+bindir          := $(prefix)/bin
+
+CFLAGS   += -Wall -pipe -std=gnu90 -DXCOMPILE $(shell $(PKG_CONFIG) --cflags sdl)
+LDLIBS   := $(shell $(PKG_CONFIG) --libs sdl) -lm
+
+all: $(TARGET)
+$(TARGET): main.c common.h functions.h structs.h
+	$(CC) $(CPPFLAGS) $(CFLAGS) -c main.c
+	$(CC) $(CFLAGS) $(LDFLAGS) main.o -o $(TARGET) $(LDLIBS)
+
+clean:
+	-@$(RM_F) $(TARGET) main.o
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
