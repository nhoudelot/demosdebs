--- a/main.c
+++ b/main.c
@@ -10,20 +10,97 @@
 #include "structs.h"
 #include "common.h"
 #include "functions.h"
+#include <stdio.h>
+#include <string.h>
+
+static SDL_Window* sdl_window;
+static SDL_Renderer* sdl_renderer;
+static SDL_Texture* sdl_texture;
+static int quit_requested;
+static int fullscreen;
+
+#define FRAME_TICKS 16 /* the animation was designed for at most ~60 fps */
+
+/* Show the software frame buffer, wait for the next frame and read events. */
+static void present_frame(SDL_Surface* screen) {
+	static Uint32 last_frame;
+	SDL_Event event;
+	Uint32 elapsed;
+
+	SDL_UpdateTexture(sdl_texture, NULL, screen->pixels, screen->pitch);
+	SDL_RenderClear(sdl_renderer);
+	SDL_RenderCopy(sdl_renderer, sdl_texture, NULL, NULL);
+	SDL_RenderPresent(sdl_renderer);
+
+	elapsed = SDL_GetTicks() - last_frame;
+	if (elapsed < FRAME_TICKS)
+		SDL_Delay(FRAME_TICKS - elapsed);
+	last_frame = SDL_GetTicks();
+
+	while (SDL_PollEvent(&event)) {
+		if (event.type == SDL_QUIT) {
+			quit_requested = 1;
+		} else if (event.type == SDL_KEYDOWN && event.key.keysym.sym == SDLK_f) {
+			if (!event.key.repeat) {
+				fullscreen = !fullscreen;
+				SDL_SetWindowFullscreen(sdl_window, fullscreen ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
+			}
+		} else if (event.type == SDL_KEYDOWN) {
+			quit_requested = 1;
+		}
+	}
+}
 
