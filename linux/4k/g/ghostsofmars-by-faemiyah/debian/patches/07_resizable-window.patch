+#if defined(USE_LD)
+/// \brief Follow the size of the drawable area.
+///
+/// Called every frame: SDL2 sends no resize event when the window is created
+/// directly at the desktop size (fullscreen at startup).
+static void update_viewport(SDL_Window *window)
+{
+  static int last_w = 0;
+  static int last_h = 0;
+  int new_w;
+  int new_h;
+
+  SDL_GL_GetDrawableSize(window, &new_w, &new_h);
+  if((0 >= new_w) || (0 >= new_h) || ((new_w == last_w) && (new_h == last_h)))
+  {
+    return;
+  }
+  last_w = new_w;
+  last_h = new_h;
+
+  glViewport(0, 0, new_w, new_h);
+
+  float fw = static_cast<float>(new_w);
+  float fh = static_cast<float>(new_h);
+  if(new_w > new_h)
+  {
+    glProgramUniform3f(g_program_fragment, g_uniform_aspect, fw / fh, 1.0f, 2.0f / fh);
+  }
+  else
+  {
+    glProgramUniform3f(g_program_fragment, g_uniform_aspect, 1.0f, fh / fw, 2.0f / fw);
+  }
+}
+#endif
