Description: adapt the Makefile to Debian packaging
 Use pkg-config, honour CC, CPPFLAGS, CFLAGS and LDFLAGS from
 dpkg-buildflags (hardening), add an install target and do not strip.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-14
--- a/Makefile
+++ b/Makefile
@@ -1,17 +1,40 @@
-CC = gcc
-COPT = -O2 -ffast-math `sdl-config --cflags`
-LIB = `sdl-config --libs` -lm
+#variables de compilation
+SHELL = /bin/sh
+CC    ?= gcc
+PKG_CONFIG ?= pkg-config
+CFLAGS   += -Wall -pipe -std=gnu90 $(shell $(PKG_CONFIG) --cflags sdl gl)
+LDFLAGS  += $(shell $(PKG_CONFIG) --libs sdl gl) -lm
+TARGET := jeregrette-by-fitandbandwagon
+#variable de nettoyage
+RM_F := rm -f
+#variables d'instalation
+INSTALL = install
+INSTALL_DIR     = $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM = $(INSTALL) -p    -m  755
+prefix          = /usr
+exec_prefix     = $(prefix)
+bindir          = $(prefix)/bin
+
+#parallel compilation if available
+ifneq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
+ NUMJOBS = $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
+ MAKEFLAGS += -j$(NUMJOBS)
+endif
 
 OBJ = syna.o main.o osa.o biisi.o
 
-NAME = je_regrette
+all: $(TARGET)
 
-$(NAME): $(OBJ)
-	$(CC) -o $@ $(OBJ) $(LIB)
-	strip $@
+$(TARGET): $(OBJ)
+	$(CC) $(CFLAGS) -o $@ $(OBJ) $(LDFLAGS)
 
 %.o: %.c letters2.h
-	$(CC) $(COPT) -c $<
-       
+	$(CC) $(CPPFLAGS) $(CFLAGS) -c $<
+
 clean:
-	rm *.o $(NAME) core *~
+	-@$(RM_F) *.o $(NAME) core *~ $(TARGET)
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
