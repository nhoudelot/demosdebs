Description: replace the upstream GNUmakefile with a packaging friendly Makefile
 Use pkg-config (cross-compilation aware) instead of sdl-config, honour the
 CPPFLAGS, CXXFLAGS and LDFLAGS set by dpkg-buildflags and add an install
 target.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-13
--- a/GNUmakefile
+++ /dev/null
@@ -1,23 +0,0 @@
-
-SOURCE := $(shell ls *.cpp | head --lines=1)
-CFLAGS = -ansi -pedantic -W -Wall
-SDL_FLAGS = `sdl-config --cflags`
-SDL_LIBS = `sdl-config --libs`
-LDLIBS = -lm
-GLLIBS = -lGL -lGLU
-
-TARGETS = entry 
-
-all: $(TARGETS)
-
-entry: entry.o
-	$(CXX) $(LDFLAGS) $^ $(LOADLIBES) $(LDLIBS) $(GLLIBS) $(SDL_LIBS) -o $@
-
-entry.o: $(SOURCE)
-	$(CXX) -c $(CPPFLAGS) $(CFLAGS) $(SDL_FLAGS) -o $@ $<
-
-distclean: clean
-	$(RM) $(TARGETS)
-
-clean:
-	$(RM) *.o *~
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,31 @@
+#variables de compilation
+SHELL = /bin/sh
+CXX   ?= g++
+PKG_CONFIG ?= pkg-config
+CXXFLAGS += -std=gnu++98 -fabi-version=2 -Wall -pipe $(shell $(PKG_CONFIG) --cflags sdl glu gl)
+LDFLAGS  += $(shell $(PKG_CONFIG) --libs sdl glu gl) -lm
+TARGET   := bugymetaballs-by-lordcow
+#variable de nettoyage
+RM_F := rm -f
+#variables d'instalation
+INSTALL = install
+INSTALL_DIR     = $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM = $(INSTALL) -p    -m  755
+prefix          = /usr
+exec_prefix     = $(prefix)
+bindir          = $(prefix)/bin
+
+SOURCE          = buggy_metaballs.cpp
+
+all: $(TARGET)
+
+$(TARGET): $(SOURCE)
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(SOURCE) -o $(TARGET) $(LDFLAGS)
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
+
+clean:
+	-$(RM_F) $(TARGET)
