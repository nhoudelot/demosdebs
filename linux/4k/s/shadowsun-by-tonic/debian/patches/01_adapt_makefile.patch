Description: add a Makefile for packaging
 Add a Makefile using pkg-config and the build flags of dpkg-buildflags
 (CPPFLAGS, CFLAGS, LDFLAGS) for hardening, and a g.h header with the
 includes needed by shadowsun.c.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-18
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,33 @@
+#variables de compilation
+SHELL := /bin/sh
+CC    := gcc
+PKG_CONFIG:=pkg-config
+CFLAGS   += -std=c99 -Wall -pipe $(shell $(PKG_CONFIG) --cflags sdl glu gl)
+LDFLAGS  += $(shell $(PKG_CONFIG) --libs sdl glu gl) -lm
+TARGET   := shadowsun-by-tonic
+#variable de nettoyage
+RM_F := rm -f
+#variables d'instalation
+INSTALL = install
+INSTALL_DIR     = $(INSTALL) -p -d -m  755
+INSTALL_PROGRAM = $(INSTALL) -p    -m  755
+prefix          = /usr
+exec_prefix     = $(prefix)
+bindir          = $(prefix)/bin
+
+SOURCE          = shadowsun.c
+
+export
+
+all: $(TARGET)
+
+$(TARGET): $(SOURCE) g.h
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SOURCE) -o $(TARGET) $(LDFLAGS)
+
+install: $(TARGET)
+	$(INSTALL_DIR) $(DESTDIR)$(bindir)
+	-@$(RM_F) $(DESTDIR)$(bindir)/$(TARGET)
+	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(bindir)
+
+clean:
+	-$(RM_F) $(TARGET)
--- /dev/null
+++ b/g.h
@@ -0,0 +1,5 @@
+#include <SDL/SDL.h>
+#include <SDL/SDL_opengl.h>
+#include <math.h>
