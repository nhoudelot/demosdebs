Description: build with portable flags and the Debian build flags
 - remove the x86-only options (-malign-data, -mno-fancy-math-387,
   -mno-ieee-fp) and the start files/default libraries hack, so the demo
   builds on every architecture;
 - pass CPPFLAGS and LDFLAGS so that the hardening flags are applied, and
   take the CFLAGS and libraries of GTK 3 and OpenGL from pkg-config;
 - do not run the size check of the packed upstream binary in the default
   target.
Author: Nicolas HOUDELOT <nicolas@demosdebs.org>
Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
Forwarded: not-needed
Last-Update: 2026-11-19
--- a/Makefile
+++ b/Makefile
@@ -33,44 +33,18 @@
 
 #huge greets to donnerbrenn!
 CFLAGS += -std=gnu11
-
 CFLAGS += -fno-plt
-#CFLAGS += -fno-stack-protector -fno-stack-check
-#CFLAGS += -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-exceptions
 CFLAGS += -funsafe-math-optimizations -ffast-math
-CFLAGS += -fomit-frame-pointer
 CFLAGS += -ffunction-sections -fdata-sections
 CFLAGS += -fmerge-all-constants
-#CFLAGS += -fno-PIC -fno-PIE
-CFLAGS += -malign-data=cacheline
-CFLAGS += -mno-fancy-math-387 -mno-ieee-fp
