#!/bin/bash -e

source /usr/share/common-install-function-ddebs/common-install-function

domain=strata-by-luminaire

APP_FULLNAME="Strata"
APP_COPYRIGHT="Luminaire"
APP_DESC="4k intro by Luminaire, released in 2015"

APP_EXE="strata-by-luminaire"

# the intro writes raw audio (16 bits, stereo, 44100 Hz) on stdout
function play()
{
	if command -v pw-play >/dev/null && [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pipewire-0" ]; then
		pw-play --format s16 --rate 44100 --channels 2 -
	elif command -v paplay >/dev/null && pactl info >/dev/null 2>&1; then
		paplay --raw --format=s16le --rate=44100 --channels=2
	else
		aplay -q -f cd
	fi
}

function run()
{
	cd /usr/lib/i386-linux-gnu/${domain} || exit
	SDL12COMPAT_SYNC_TO_VBLANK=1 LD_LIBRARY_PATH=/usr/lib/i386-linux-gnu/sdl12-compat/ ./${APP_EXE} | play
}

if [ "$#" -gt "1" ]; then
	 NSH_std_usage
	exit 1
elif [ "$#" -lt "1" ]; then
	run
else
	case "$1" in
	--help)
		NSH_std_usage
		;;
	*)
		NSH_std_usage
		exit 1
		;;
	esac
fi

exit 0
